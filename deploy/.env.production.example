# Copy this file to deploy/.env and replace every deployment-specific placeholder.
APP_ENV=staging
HTTP_BIND_ADDR=0.0.0.0
HTTP_PORT=8080
DATA_ROOT=/srv/math-knowledge/data
BACKUP_ROOT=/srv/math-knowledge/backups

DATABASE_URL=sqlite:////data/math_knowledge.db
STATIC_DIR=/data/static
# Uploads stay outside the public /static mount; question images are served through
# the authenticated /api/v1/questions/{id}/image endpoint (#44).
UPLOAD_DIR=/data/uploads
PDF_TEMP_DIR=/data/pdf_temp
PDF_SERVICE_CONNECT_TIMEOUT_SECONDS=5
PDF_SERVICE_READ_TIMEOUT_SECONDS=60
# 版面检测模型目录：必须落在持久卷内。缺省 weights 是容器内临时路径且不可写，
# 漏设后果：版面检测静默降级为无图流程，且每次重启重新下载模型（见 deploy/README.md）。
LAYOUT_MODEL_DIR=/data/models

LOG_LEVEL=INFO
LOG_DIR=/data/logs
# GIT_SHA 在镜像构建时写入，仅用于 /healthz 展示，无需在此配置。
# GIT_SHA=

SECRET_KEY=
CORS_ALLOW_ORIGINS=http://SERVER_IP:PORT

OCR_PROVIDER=baidu
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
DEEPSEEK_API_KEY=

AUTH_STRICT_SECURITY=false
SECURE_TRANSPORT_MODE=insecure_http
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax

PUBLIC_SIGNUP_ENABLED=true
ALLOW_RUNTIME_SCHEMA_MUTATIONS=false
AUTO_CREATE_TABLES=false
AUTO_APPLY_LEGACY_QUESTION_COMPAT=false
