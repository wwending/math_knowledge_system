APP_ENV=development
DATABASE_URL=sqlite:///./math_knowledge.db
SECRET_KEY=replace-with-at-least-32-characters
CORS_ALLOW_ORIGINS=http://localhost:5173

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_PATH=/
AUTH_STRICT_SECURITY=false
SECURE_TRANSPORT_MODE=insecure_http
ALLOW_CROSS_SITE_REFRESH_COOKIE=false
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax

PUBLIC_SIGNUP_ENABLED=true
SMS_CODE_LOGIN_ENABLED=false
SMS_PASSWORD_RECOVERY_ENABLED=false
PASSWORD_RECOVERY_MODE=admin_contact

LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_BLOCK_SECONDS=1800

BAIDU_API_KEY=
BAIDU_SECRET_KEY=
OCR_PROVIDER=baidu
# RapidOCR is retained only as historical experiment code and is not part of v0.1 delivery.
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_METADATA_TIMEOUT_SECONDS=45

# Layout analysis (#58): figure-region detection on question crops.
# The DocLayout-YOLO model (~50MB) is downloaded once on first use from
# ModelScope into LAYOUT_MODEL_DIR and kept across deployments; point it at a
# persistent volume in production (e.g. LAYOUT_MODEL_DIR=/data/models).
# Detection failures degrade to the pre-#58 no-figure flow.
LAYOUT_ENABLED=true
LAYOUT_MODEL_TYPE=doclayout_docstructbench
LAYOUT_MODEL_DIR=weights
LAYOUT_MODEL_PATH=
LAYOUT_TIMEOUT_SECONDS=15
LAYOUT_CONF_THRESHOLD=0.4
LAYOUT_MIN_AREA_RATIO=0.01
LAYOUT_FIGURE_LABELS=figure

ALLOW_RUNTIME_SCHEMA_MUTATIONS=false
AUTO_CREATE_TABLES=false
AUTO_APPLY_LEGACY_QUESTION_COMPAT=false

LOG_LEVEL=INFO
LOG_DIR=logs
